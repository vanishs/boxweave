root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
tab_width = 8

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[*.{md,py,sh}]
indent_size = 4

[*.md]
# Explicit Markdown hard-breaks in historical documents are exempt from
# whole-repository legacy scanning, but new diffs cannot add whitespace.
trim_trailing_whitespace = true
