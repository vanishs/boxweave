index 0000000..eef4b04
--- /dev/null
+++ b/internal/server/tenant_access_postgres_test.go
@@ -0,0 +1,99 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	pb "github.com/footprintai/containarium/pkg/pb/containarium/v1"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"google.golang.org/protobuf/proto"
+	"os"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestTenantAccessPostgresAtomicityPreservationAndConcurrency(t *testing.T) {
+	dsn := os.Getenv("TEST_TENANT_PG_DSN")
+	if dsn == "" {
+		t.Skip("set TEST_TENANT_PG_DSN for an isolated PostgreSQL fixture")
+	}
+	ctx := context.Background()
+	admin, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Close()
+	schema := fmt.Sprintf("tenant_access_test_%d", time.Now().UnixNano())
+	quoted := pgx.Identifier{schema}.Sanitize()
+	if _, err := admin.Exec(ctx, "CREATE SCHEMA "+quoted); err != nil {
+		t.Fatal(err)
+	}
+	defer admin.Exec(ctx, "DROP SCHEMA "+quoted+" CASCADE")
+	cfg, err := pgxpool.ParseConfig(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	store, err := NewPostgresNetworkPolicyStore(ctx, pool)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := richAccessPolicy("testing")
+	if err := store.Set(ctx, old); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.MutateDenyRules(ctx, "testing", func([]*pb.NetworkPolicyDenyRule) ([]*pb.NetworkPolicyDenyRule, error) { return old.DenyRules, nil }); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := store.Get(ctx, "testing")
+	changed, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "allinone", AddSources: []string{"testing"}, ExpectedRevision: "absent"}, {Destination: "testing", AddSources: []string{"allinone"}, ExpectedRevision: PolicyRevision(before)}})
+	if err != nil || len(changed) != 2 {
+		t.Fatalf("atomic two-way mutation: %v", err)
+	}
+	after, _ := store.Get(ctx, "testing")
+	without := proto.Clone(after).(*pb.NetworkPolicy)
+	without.AllowFromTenants = nil
+	if !proto.Equal(without, before) {
+		t.Fatal("Postgres ingress UPDATE lost other policy fields")
+	}
+	_, err = store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "new-empty", AddSources: []string{"testing"}, ExpectedRevision: "absent"}, {Destination: "testing", RemoveSources: []string{"allinone"}, ExpectedRevision: PolicyRevision(before)}})
+	if !errors.Is(err, ErrTenantAccessConflict) {
+		t.Fatal("stale preview did not conflict")
+	}
+	if _, err := store.Get(ctx, "new-empty"); !errors.Is(err, ErrNetworkPolicyNotFound) {
+		t.Fatal("failed batch left an inserted row")
+	}
+	rev := PolicyRevision(after)
+	errs := make(chan error, 2)
+	var wg sync.WaitGroup
+	for _, src := range []string{"first", "second"} {
+		wg.Add(1)
+		go func(src string) {
+			defer wg.Done()
+			_, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "testing", AddSources: []string{src}, ExpectedRevision: rev}})
+			errs <- err
+		}(src)
+	}
+	wg.Wait()
+	close(errs)
+	success, conflict := 0, 0
+	for err := range errs {
+		if err == nil {
+			success++
+		} else if errors.Is(err, ErrTenantAccessConflict) {
+			conflict++
+		} else {
+			t.Fatal(err)
+		}
+	}
+	if success != 1 || conflict != 1 {
+		t.Fatal("Postgres CAS lost a concurrent edit")
+	}
+}
diff --git a/internal/server/tenant_access_server.go b/internal/server/tenant_access_server.go
new file mode 100644
index 0000000..c144e46
--- /dev/null
+++ b/internal/server/tenant_access_server.go
@@ -0,0 +1,104 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"github.com/footprintai/containarium/internal/auth"
+	pb "github.com/footprintai/containarium/pkg/pb/containarium/v1"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"log"
+	"time"
+)
+
+const TenantNetworkContract = "boxweave.tenant-network/v1"
+
+func (s *NetworkPolicyServer) guardReady() bool {
+	if s.tenantGuardRead == nil || s.tenantStoreDurable == nil || !s.tenantStoreDurable() {
+		return false
+	}
+	g := s.tenantGuardRead()
+	stamp, err := time.Parse(time.RFC3339, g.GetLastPass())
+	age := time.Since(stamp)
+	for _, entry := range g.Entries {
+		if !entry.Attached || entry.LastError != "" {
+			return false
+		}
+	}
+	return err == nil && age >= -30*time.Second && age <= 180*time.Second && g.Mode == pb.GuardMode_GUARD_MODE_ENFORCE && g.FirewallDriver == "nftables" && !g.Unsupported && g.LastError == "" && g.StaleSince == "" && len(g.Unresolved) == 0
+}
+
+func (s *NetworkPolicyServer) GetNetworkTenantCapabilities(ctx context.Context, _ *pb.GetNetworkTenantCapabilitiesRequest) (*pb.GetNetworkTenantCapabilitiesResponse, error) {
+	if err := auth.RequireRole(ctx, auth.RoleAdmin); err != nil {
+		return nil, err
+	}
+	if err := auth.RequireScope(ctx, auth.ScopeContainersRead); err != nil {
+		return nil, err
+	}
+	_, atomic := s.store.(TenantAccessStore)
+	atomic = atomic && s.tenantGuardRead != nil && s.tenantStoreDurable != nil && s.tenantStoreDurable()
+	allowed := auth.RequireScope(ctx, auth.ScopeNetworkPolicyWrite) == nil
+	ready := s.guardReady()
+	reason := ""
+	if !ready {
+		reason = "fresh enforced supported local LXC Guard and durable policy store required"
+	}
+	return &pb.GetNetworkTenantCapabilitiesResponse{Contract: TenantNetworkContract, NativeMembershipRead: true, SharedTenantCreate: ready, AtomicTenantAccess: atomic, NetworkPolicyWrite: atomic && allowed, Reason: reason, BackendScope: "local-lxc"}, nil
+}
+
+func (s *NetworkPolicyServer) PatchTenantAccess(ctx context.Context, req *pb.PatchTenantAccessRequest) (*pb.PatchTenantAccessResponse, error) {
+	if err := auth.RequireRole(ctx, auth.RoleAdmin); err != nil {
+		return nil, err
+	}
+	if err := auth.RequireScope(ctx, auth.ScopeNetworkPolicyWrite); err != nil {
+		return nil, err
+	}
+	if err := validateAccessChanges(req.GetChanges()); err != nil {
+		return nil, status.Error(codes.InvalidArgument, err.Error())
+	}
+	store, ok := s.store.(TenantAccessStore)
+	if !ok {
+		return nil, status.Error(codes.Unimplemented, "atomic Tenant access unavailable")
+	}
+	if s.tenantGuardRead == nil || s.tenantStoreDurable == nil {
+		return nil, status.Error(codes.FailedPrecondition, "local LXC Tenant Guard contract is not configured")
+	}
+	if !s.guardReady() {
+		for _, change := range req.Changes {
+			if len(change.AddSources) > 0 {
+				return nil, status.Error(codes.FailedPrecondition, "grant requires fresh ENFORCE supported Tenant Guard")
+			}
+		}
+	}
+	if s.tenantStoreDurable != nil && !s.tenantStoreDurable() {
+		return nil, status.Error(codes.FailedPrecondition, "durable policy store unavailable")
+	}
+	policies, err := store.PatchTenantAccess(ctx, req.Changes)
+	if errors.Is(err, ErrTenantAccessConflict) {
+		return nil, status.Error(codes.Aborted, err.Error())
+	}
+	if err != nil {
+		return nil, status.Error(codes.Internal, "atomic Tenant access store failed")
+	}
+	// Store success is not enforcement success. Never roll back unrelated policy
+	// writes or report a TCP result from an ACL reconciliation.
+	applied := "pending"
+	if s.tenantGuardReconcile != nil {
+		if err := s.tenantGuardReconcile(ctx); err != nil {
+			applied = "degraded"
+		} else if s.guardReady() {
+			applied = "guard_verified"
+			for _, p := range policies {
+				current, e := s.store.Get(ctx, p.Policy.Tenant)
+				if e != nil || PolicyRevision(current) != p.Revision {
+					applied = "pending"
+				}
+			}
+		}
+	}
+	actor, _, _ := auth.SubjectFromGRPCContext(ctx)
+	for _, c := range req.Changes {
+		log.Printf("[tenant-access] actor=%q destination=%q add=%q remove=%q state=%s", actor, c.Destination, c.AddSources, c.RemoveSources, applied)
+	}
+	return &pb.PatchTenantAccessResponse{Policies: policies, ApplicationState: applied, ConnectivityTested: false}, nil
+}
diff --git a/internal/server/tenant_access_store.go b/internal/server/tenant_access_store.go
new file mode 100644
index 0000000..045188d
--- /dev/null
+++ b/internal/server/tenant_access_store.go
@@ -0,0 +1,179 @@
+package server
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"github.com/footprintai/containarium/pkg/core/incus"
+	pb "github.com/footprintai/containarium/pkg/pb/containarium/v1"
+	"google.golang.org/protobuf/proto"
+	"sort"
+)
+
+var ErrTenantAccessConflict = errors.New("network policy changed since preview")
+
+type TenantAccessStore interface {
+	PatchTenantAccess(context.Context, []*pb.TenantAccessChange) ([]*pb.TenantAccessPolicy, error)
+}
+
+// PolicyRevision covers the entire policy, including independently managed deny
+// rules. An ingress patch can never silently discard an intervening policy edit.
+func PolicyRevision(p *pb.NetworkPolicy) string {
+	if p == nil {
+		return "absent"
+	}
+	b, _ := proto.MarshalOptions{Deterministic: true}.Marshal(p)
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+func validateAccessChanges(changes []*pb.TenantAccessChange) error {
+	if len(changes) == 0 || len(changes) > 32 {
+		return fmt.Errorf("1-32 destination changes required")
+	}
+	seen := map[string]bool{}
+	for _, c := range changes {
+		if c == nil {
+			return fmt.Errorf("invalid destination change")
+		}
+		if err := incus.ValidateNetworkTenant(c.Destination); err != nil {
+			return err
+		}
+		if seen[c.Destination] {
+			return fmt.Errorf("duplicate destination")
+		}
+		seen[c.Destination] = true
+		if c.ExpectedRevision != "absent" {
+			b, err := hex.DecodeString(c.ExpectedRevision)
+			if err != nil || len(b) != 32 {
+				return fmt.Errorf("expected full policy revision is required")
+			}
+		}
+		if len(c.AddSources)+len(c.RemoveSources) == 0 || len(c.AddSources)+len(c.RemoveSources) > 100 {
+			return fmt.Errorf("1-100 ingress source edits required")
+		}
+		sources := map[string]bool{}
+		for _, src := range append(append([]string{}, c.AddSources...), c.RemoveSources...) {
+			if err := incus.ValidateNetworkTenant(src); err != nil {
+				return err
+			}
+			if src == c.Destination || sources[src] {
+				return fmt.Errorf("self, duplicate or contradictory ingress source")
+			}
+			sources[src] = true
+		}
+	}
+	return nil
+}
+
+func applyAccess(old *pb.NetworkPolicy, c *pb.TenantAccessChange) (*pb.NetworkPolicy, error) {
+	if PolicyRevision(old) != c.ExpectedRevision {
+		return nil, ErrTenantAccessConflict
+	}
+	var next *pb.NetworkPolicy
+	if old == nil {
+		// No pre-existing egress policy is reset. The new record remains log-only;
+		// its allow_from_tenants is consumed independently by the NIC guard.
+		next = &pb.NetworkPolicy{Tenant: c.Destination}
+	} else {
+		next = proto.Clone(old).(*pb.NetworkPolicy)
+	}
+	allowed := map[string]bool{}
+	for _, src := range next.AllowFromTenants {
+		allowed[src] = true
+	}
+	for _, src := range c.RemoveSources {
+		delete(allowed, src)
+	}
+	for _, src := range c.AddSources {
+		allowed[src] = true
+	}
+	next.AllowFromTenants = nil
+	for src := range allowed {
+		next.AllowFromTenants = append(next.AllowFromTenants, src)
+	}
+	sort.Strings(next.AllowFromTenants)
+	return next, nil
+}
+
+func (s *MemNetworkPolicyStore) PatchTenantAccess(_ context.Context, changes []*pb.TenantAccessChange) ([]*pb.TenantAccessPolicy, error) {
+	if err := validateAccessChanges(changes); err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	next := map[string]*pb.NetworkPolicy{}
+	out := []*pb.TenantAccessPolicy{}
+	for _, c := range changes {
+		p, err := applyAccess(s.m[c.Destination], c)
+		if err != nil {
+			return nil, err
+		}
+		next[c.Destination] = p
+		out = append(out, &pb.TenantAccessPolicy{Policy: proto.Clone(p).(*pb.NetworkPolicy), Revision: PolicyRevision(p)})
+	}
+	for key, p := range next {
+		s.m[key] = p
+	}
+	return out, nil
+}
+
+func (s *PostgresNetworkPolicyStore) PatchTenantAccess(ctx context.Context, changes []*pb.TenantAccessChange) ([]*pb.TenantAccessPolicy, error) {
+	if err := validateAccessChanges(changes); err != nil {
+		return nil, err
+	}
+	// Consistent lock order avoids A/B vs B/A deadlocks. No caller input mutation.
+	changes = append([]*pb.TenantAccessChange(nil), changes...)
+	sort.Slice(changes, func(i, j int) bool { return changes[i].Destination < changes[j].Destination })
+	tx, err := s.pool.Begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx)
+	out := []*pb.TenantAccessPolicy{}
+	for _, c := range changes {
+		tag, err := tx.Exec(ctx, `INSERT INTO network_policies (tenant) VALUES ($1) ON CONFLICT (tenant) DO NOTHING`, c.Destination)
+		if err != nil {
+			return nil, err
+		}
+		inserted := tag.RowsAffected() == 1
+		p := &pb.NetworkPolicy{Tenant: c.Destination}
+		var mode, preset int32
+		var deny []byte
+		err = tx.QueryRow(ctx, `SELECT allow_intra_tenant,egress_cidrs,egress_domains,mode,allow_metadata,source,deny_rules,allow_from_tenants,egress_preset FROM network_policies WHERE tenant=$1 FOR UPDATE`, c.Destination).Scan(&p.AllowIntraTenant, &p.EgressCidrs, &p.EgressDomains, &mode, &p.AllowMetadata, &p.Source, &deny, &p.AllowFromTenants, &preset)
+		if err != nil {
+			return nil, err
+		}
+		p.Mode = pb.NetworkPolicyMode(mode)
+		p.EgressPreset = pb.EgressPreset(preset)
+		p.DenyRules, err = decodeDenyRules(deny)
+		if err != nil {
+			return nil, err
+		}
+		if inserted {
+			p = nil
+		}
+		next, err := applyAccess(p, c)
+		if err != nil {
+			return nil, err
+		}
+		// Only ingress sources change. Default mode for an absent record is already
+		// unspecified/log-only; do not UPDATE any egress, mode, metadata or deny field.
+		if inserted {
+			next.Mode = pb.NetworkPolicyMode_NETWORK_POLICY_MODE_UNSPECIFIED
+		}
+		if _, err = tx.Exec(ctx, `UPDATE network_policies SET allow_from_tenants=$2,updated_at=NOW() WHERE tenant=$1`, c.Destination, nonNilStrings(next.AllowFromTenants)); err != nil {
+			return nil, err
+		}
+		out = append(out, &pb.TenantAccessPolicy{Policy: next, Revision: PolicyRevision(next)})
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+var _ TenantAccessStore = (*MemNetworkPolicyStore)(nil)
+var _ TenantAccessStore = (*PostgresNetworkPolicyStore)(nil)
diff --git a/internal/server/tenant_access_test.go b/internal/server/tenant_access_test.go
new file mode 100644
index 0000000..ddf2c8e
--- /dev/null
+++ b/internal/server/tenant_access_test.go
@@ -0,0 +1,158 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"github.com/footprintai/containarium/internal/auth"
+	pb "github.com/footprintai/containarium/pkg/pb/containarium/v1"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"sync"
+	"testing"
+	"time"
+)
+
+func richAccessPolicy(key string) *pb.NetworkPolicy {
+	return &pb.NetworkPolicy{Tenant: key, AllowIntraTenant: true, EgressCidrs: []string{"10.0.0.0/8"}, EgressDomains: []string{"example.com"}, Mode: pb.NetworkPolicyMode_NETWORK_POLICY_MODE_ENFORCE, AllowMetadata: true, Source: "cloud-managed", EgressPreset: pb.EgressPreset_EGRESS_PRESET_ALLOW_LIST_ONLY, DenyRules: []*pb.NetworkPolicyDenyRule{{Cidr: "10.2.3.4/32", Port: 443, Note: "keep"}}}
+}
+func TestTenantAccessDirectionPreservationAndRevocation(t *testing.T) {
+	store := NewMemNetworkPolicyStore()
+	ctx := context.Background()
+	old := richAccessPolicy("testing")
+	_ = store.Set(ctx, old)
+	// Set owns allow-policy, seed independently managed deny rules through its API.
+	_, _ = store.MutateDenyRules(ctx, "testing", func([]*pb.NetworkPolicyDenyRule) ([]*pb.NetworkPolicyDenyRule, error) { return old.DenyRules, nil })
+	before, _ := store.Get(ctx, "testing")
+	change := &pb.TenantAccessChange{Destination: "testing", AddSources: []string{"allinone"}, ExpectedRevision: PolicyRevision(before)}
+	out, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{change})
+	if err != nil {
+		t.Fatal(err)
+	}
+	after := out[0].Policy
+	if len(after.AllowFromTenants) != 1 || after.AllowFromTenants[0] != "allinone" {
+		t.Fatal("authorization applied to wrong destination")
+	}
+	actual := proto.Clone(after).(*pb.NetworkPolicy)
+	actual.AllowFromTenants = nil
+	if !proto.Equal(actual, before) {
+		t.Fatal("ingress patch clobbered another security field")
+	}
+	if _, err := store.Get(ctx, "allinone"); !errors.Is(err, ErrNetworkPolicyNotFound) {
+		t.Fatal("one direction implicitly granted reverse access")
+	}
+	_, err = store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "testing", RemoveSources: []string{"allinone"}, ExpectedRevision: PolicyRevision(after)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, _ := store.Get(ctx, "testing")
+	if !proto.Equal(restored, before) {
+		t.Fatal("revoke failed to restore policy exactly")
+	}
+}
+func TestTenantAccessBidirectionalAtomicConflict(t *testing.T) {
+	store := NewMemNetworkPolicyStore()
+	ctx := context.Background()
+	_ = store.Set(ctx, &pb.NetworkPolicy{Tenant: "testing"})
+	_, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "allinone", AddSources: []string{"testing"}, ExpectedRevision: "absent"}, {Destination: "testing", AddSources: []string{"allinone"}, ExpectedRevision: "absent"}})
+	if !errors.Is(err, ErrTenantAccessConflict) {
+		t.Fatalf("wanted revision conflict: %v", err)
+	}
+	if _, err = store.Get(ctx, "allinone"); !errors.Is(err, ErrNetworkPolicyNotFound) {
+		t.Fatal("partial bidirectional write committed")
+	}
+	existing, _ := store.Get(ctx, "testing")
+	out, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "allinone", AddSources: []string{"testing"}, ExpectedRevision: "absent"}, {Destination: "testing", AddSources: []string{"allinone"}, ExpectedRevision: PolicyRevision(existing)}})
+	if err != nil || len(out) != 2 {
+		t.Fatalf("bidirectional mutation: %v", err)
+	}
+}
+func TestTenantAccessConcurrentPreviewHasOneWinner(t *testing.T) {
+	store := NewMemNetworkPolicyStore()
+	ctx := context.Background()
+	_ = store.Set(ctx, &pb.NetworkPolicy{Tenant: "testing"})
+	old, _ := store.Get(ctx, "testing")
+	var wg sync.WaitGroup
+	errs := make(chan error, 2)
+	for _, src := range []string{"first", "second"} {
+		wg.Add(1)
+		go func(src string) {
+			defer wg.Done()
+			_, err := store.PatchTenantAccess(ctx, []*pb.TenantAccessChange{{Destination: "testing", AddSources: []string{src}, ExpectedRevision: PolicyRevision(old)}})
+			errs <- err
+		}(src)
+	}
+	wg.Wait()
+	close(errs)
+	success, conflict := 0, 0
+	for err := range errs {
+		if err == nil {
+			success++
+		} else if errors.Is(err, ErrTenantAccessConflict) {
+			conflict++
+		} else {
+			t.Fatal(err)
+		}
+	}
+	if success != 1 || conflict != 1 {
+		t.Fatal("concurrent preview lost an update")
+	}
+}
+func TestTenantAccessPermissionAndNoConnectivityClaim(t *testing.T) {
+	s := newNPServer()
+	s.tenantStoreDurable = func() bool { return true }
+	s.tenantGuardRead = func() *pb.GuardStatus {
+		return &pb.GuardStatus{Mode: pb.GuardMode_GUARD_MODE_ENFORCE, FirewallDriver: "nftables", LastPass: time.Now().UTC().Format(time.RFC3339)}
+	}
+	req := &pb.PatchTenantAccessRequest{Changes: []*pb.TenantAccessChange{{Destination: "testing", AddSources: []string{"allinone"}, ExpectedRevision: "absent"}}}
+	for _, ctx := range []context.Context{context.Background(), auth.ContextWithTestSubject(context.Background(), "user", "user"), auth.ContextWithTestSubjectScopes(context.Background(), "admin", []string{auth.RoleAdmin}, []string{auth.ScopeContainersWrite})} {
+		if _, err := s.PatchTenantAccess(ctx, req); err == nil {
+			t.Fatal("unauthorized policy mutation")
+		}
+	}
+	scoped := auth.ContextWithTestSubjectScopes(context.Background(), "admin", []string{auth.RoleAdmin}, []string{auth.ScopeContainersWrite})
+	if _, err := s.SetNetworkPolicy(scoped, &pb.SetNetworkPolicyRequest{Policy: &pb.NetworkPolicy{Tenant: "testing", AllowFromTenants: []string{"allinone"}}}); status.Code(err) != codes.PermissionDenied {
+		t.Fatal("full-policy API bypassed ingress write scope")
+	}
+	result, err := s.PatchTenantAccess(npAdminCtx(), req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.ConnectivityTested || result.ApplicationState != "pending" {
+		t.Fatal("store success claimed network success")
+	}
+	req.Changes[0].ExpectedRevision = "absent"
+	_, err = s.PatchTenantAccess(npAdminCtx(), req)
+	if status.Code(err) != codes.Aborted {
+		t.Fatalf("expected conflict: %v", err)
+	}
+}
+func TestNetworkTenantCreateAuthority(t *testing.T) {
+	admin := npAdminCtx()
+	user := auth.ContextWithTestSubject(context.Background(), "allinone", "user")
+	for _, labels := range []map[string]string{{"tenant": "other"}, {"cloud_org_id": "other"}, {"user.containarium.tenant": "other"}} {
+		if err := authorizeNetworkTenantCreate(user, &pb.CreateContainerRequest{Username: "allinone", Labels: labels}, true); err == nil {
+			t.Fatal("label spoof admitted")
+		}
+	}
+	req := &pb.CreateContainerRequest{Username: "allinone"}
+	if err := authorizeNetworkTenantCreate(user, req, true); err != nil {
+		t.Fatal(err)
+	}
+	if req.NetworkTenant != "account:allinone" {
+		t.Fatal("username could join explicit shared domain")
+	}
+	if err := authorizeNetworkTenantCreate(user, &pb.CreateContainerRequest{Username: "allinone", NetworkTenant: "shared"}, true); status.Code(err) != codes.PermissionDenied {
+		t.Fatal("non-admin assigned shared Tenant")
+	}
+	if err := authorizeNetworkTenantCreate(admin, &pb.CreateContainerRequest{Username: "box1", NetworkTenant: "allinone"}, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := authorizeNetworkTenantCreate(admin, &pb.CreateContainerRequest{Username: "box1", NetworkTenant: "account:user"}, true); err == nil {
+		t.Fatal("reserved namespace accepted")
+	}
+	req = &pb.CreateContainerRequest{Username: "box1"}
+	if err := authorizeNetworkTenantCreate(admin, req, true); err != nil || req.NetworkTenant != "" {
+		t.Fatal("admin automatic compatibility changed")
+	}
+}
