+package incus
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+var networkTenantPattern = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,127}$`)
+
+// ValidateNetworkTenant validates a native identity, never an Incus config map.
+func ValidateNetworkTenant(key string) error {
+	if !networkTenantPattern.MatchString(key) || strings.TrimSpace(key) != key {
+		return fmt.Errorf("invalid network Tenant: use 1-128 letters, digits, colon, dot, underscore or hyphen")
+	}
+	if strings.HasPrefix(key, "containarium-core-") || strings.HasPrefix(key, "core-") {
+		return fmt.Errorf("reserved network Tenant")
+	}
+	return nil
+}
+
+func NetworkTenantIdentity(explicit, cloud, name string) (string, string) {
+	if strings.TrimSpace(explicit) != "" {
+		return strings.TrimSpace(explicit), "native"
+	}
+	if strings.TrimSpace(cloud) != "" {
+		return strings.TrimSpace(cloud), "cloud_org_id"
+	}
+	if strings.TrimSuffix(name, "-container") == "" {
+		return "", "unknown"
+	}
+	return ResolveTenant(explicit, cloud, name), "name"
+}
