diff --git a/internal/client/http_test.go b/internal/client/http_test.go
index 6ff3f27..974e240 100644
--- a/internal/client/http_test.go
+++ b/internal/client/http_test.go
@@ -413,3 +413,37 @@ func TestHTTPListAgentEngines_DecodesReadinessRows(t *testing.T) {
 		t.Errorf("codex row decoded wrong: %+v", codex)
 	}
 }
+
+func TestHTTPCreateNetworkTenantNativeTransport(t *testing.T) {
+	var gotBody map[string]any
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewDecoder(r.Body).Decode(&gotBody)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"container":{"name":"c","username":"alice"}}`))
+	}))
+	defer srv.Close()
+
+	c, err := NewHTTPClient(srv.URL, "tok")
+	if err != nil {
+		t.Fatalf("NewHTTPClient: %v", err)
+	}
+	labels := map[string]string{"team": "dev"}
+	if _, err := c.CreateContainer("alice", "img", "1", "1GB", "10GB", nil, false, "", nil, 0, 0, false, "", "", GitSourceOpts{}, 0, 0, false, 0, "", EncryptionOpts{}, "", "", "", labels, "allinone"); err != nil {
+		t.Fatalf("CreateContainer: %v", err)
+	}
+	if gotBody["networkTenant"] != "allinone" || gotBody["tenantId"] != nil {
+		t.Fatalf("wrong network/encryption wire fields: %v", gotBody)
+	}
+
+	// No labels → no field, so an older daemon sees the same body as before.
+	gotBody = nil
+	if _, err := c.CreateContainer("alice", "img", "1", "1GB", "10GB", nil, false, "", nil, 0, 0, false, "", "", GitSourceOpts{}, 0, 0, false, 0, "", EncryptionOpts{}, "", "", "", nil); err != nil {
+		t.Fatalf("CreateContainer: %v", err)
+	}
+	if _, present := gotBody["networkTenant"]; present {
+		t.Fatal("automatic mode sent networkTenant")
+	}
+	if _, present := gotBody["labels"]; present {
+		t.Errorf("labels present in body = %v, want absent when unset", gotBody["labels"])
+	}
+}
